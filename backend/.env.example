# Atar Youth Association — Backend Environment Configuration Template

# Server Configuration
NODE_ENV=development
PORT=5000

# CORS & Application URLs
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5000

# Database Connection (Supabase PostgreSQL / Standard PostgreSQL)
# Option A: Connection String (Recommended for Supabase)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Option B: Individual Parameters (Fallback)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_SSL=true

# Authentication & Security
JWT_SECRET=replace_with_a_long_random_secure_secret_key
JWT_EXPIRE=7d
BCRYPT_ROUNDS=12

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="Atar Youth Association <noreply@ataryouth.org>"

# Initial Administrator Credentials (used by seed-admin.js)
ADMIN_EMAIL=admin@ataryouth.org
ADMIN_PASSWORD=change_this_admin_password_in_production
