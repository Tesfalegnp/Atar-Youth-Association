# Atar Youth Association — Backend Environment Configuration Template

# Database Connection (Supabase PostgreSQL / Standard PostgreSQL)
# Option A: Full Connection String (Recommended for Supabase)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Option B: Individual Connection Parameters
DB_HOST=localhost
DB_PORT=5432
DB_NAME=atar_youth_south_sudan
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_SSL=false

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
CLIENT_URL=http://localhost:5173

# Security
BCRYPT_ROUNDS=12
